    vec3(0.71, 0.72, 0.45), vec3(0.55, 0.54, 0.31), vec3(0.41, 0.42, 0.22), vec3(0.47, 0.49, 0.29), vec3(0.55, 0.56, 0.37), vec3(0.41, 0.43, 0.27), vec3(0.41, 0.44, 0.32), vec3(0.35, 0.39, 0.26), vec3(0.24, 0.27, 0.16),
