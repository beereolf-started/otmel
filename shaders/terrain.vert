// Р34: вода полупрозрачная голубая - сквозь неё видно дно; та же доля - у дальних плиток (tile.vert)
const float WATER_ALPHA = 0.55;
const vec3 NORMALS[6] = vec3[](vec3(1, 0, 0), vec3(-1, 0, 0), vec3(0, 1, 0), vec3(0, -1, 0), vec3(0, 0, 1), vec3(0, 0, -1));

void main() {
    uint p = aPacked;
    vec3 local = vec3(p & 63u, (p >> 6) & 63u, (p >> 12) & 63u);
    uint normal = (p >> 18) & 7u;
    // Р82: в поле материала 11 бит. Младшие шесть - сам материал, следующие четыре - толщина снега
    // в шестнадцатых минус один. Класть её отдельным числом некуда: вершина - одно слово в 32 бита.
    uint packed = p >> 21;
    // Р89: материал - все 11 бит. Толщина снега нужна только снегу, поэтому снег занимает верхние
    // шестнадцать номеров (2032 + толщина - 1), а прочим материалам достаётся весь остальной ряд.
    uint material = packed & 2047u;
    uint snowDepth = 0u;
    if (material >= 2032u) { snowDepth = material - 2032u; material = 5u; }
    // мир - в прежних мерах (16 блоков мира, Р54); мелкий кусок - ещё в 16 раз мельче (воксель = тексель).
    // Р69: для видеокарты - относительно originV: разность считается в целых (точно), числа малые - вершины не дрожат
    // (у мира в сотни тысяч блоков у float шаг ~1/32 блока - мелкие воксели расходились щелями)
    // Р82: СНЕГ - СЛОЙ, а не заснеженный блок. Воксель снега твёрдый только в маске граней; здесь
    // его верх опускается до настоящей толщины - от 1/16 блока до целого. Опускаются лишь верхние
    // вершины грани: у грани вверх это все четыре, у боковых - две, у грани вниз ни одной.
    const ivec3 AX[3] = ivec3[](ivec3(0, 1, 2), ivec3(1, 2, 0), ivec3(2, 0, 1));   // (d, u, v): X - u=y, v=z ...
    int ai = int(normal) >> 1;
    bool minus = (normal & 1u) == 1u;
    int corner = gl_VertexID & 3;
    int cu = minus ? int[](0, 0, 1, 1)[corner] : int[](0, 1, 1, 0)[corner];   // 1 - угол на дальнем по u крае
    int cv = minus ? int[](0, 1, 1, 0)[corner] : int[](0, 0, 1, 1)[corner];
    if (material == 5u) {
        bool top = ai == 1 ? normal == 2u : (ai == 0 ? cu == 1 : cv == 1);
        if (top) local.y -= 1.0 - float(snowDepth + 1u) / 16.0;
    }
    ivec3 rc = uChunk - originV.xyz;
    vec3 rel = uFine == 1 ? (vec3(rc) + (local * float(uFineScale) + vec3(uFineOff)) / 16.0) / 16.0 : (local + vec3(rc)) / 16.0;
    // Р80: место внутри блока считаем от начала координат видеокарты, а не от начала мира. Начало
    // кратно куску, то есть целому числу блоков, поэтому рисунок от этого не сдвигается; зато числа
    // малые, и дробная часть остаётся точной. От начала мира (сотни тысяч блоков) у float шаг
    // доходит до четверти точки рисунка, и земля вдали расползалась полосами.
    vBlock = rel * 16.0;
    // Р92: ПРЕДМЕТ С ПОВОРОТОМ (лежащий сук, падающий ствол, топор в руке). Сетка построена вокруг
    // блока-основы (uChunk); строки xyz - поворот, w - куда эту основу поставить (прежние меры,
    // от начала видеокарты - числа малые). Рисунок остаётся привязан к самому предмету.
    vec3 xfN = vec3(0);
    bool xf = uFine == 1 && uXf == 1;
    vec3 xq = rel - vec3(rc) / 16.0;
    vec3 xDst = vec3(uXf0.w, uXf1.w, uXf2.w);
    if (xf) {
        vec3 n0 = NORMALS[normal];
        xfN = normalize(vec3(dot(uXf0.xyz, n0), dot(uXf1.xyz, n0), dot(uXf2.xyz, n0)));   // строки несут и масштаб
        rel = xDst + vec3(dot(uXf0.xyz, xq), dot(uXf1.xyz, xq), dot(uXf2.xyz, xq));
    }
    // Р66: щели Т-стыков. Склеенные прямоугольники сходятся вершиной посреди чужого ребра - при растеризации остаются
    // щели меньше пикселя, сквозь них видно небо (на силуэтах деревьев, краях блоков). Непрозрачный прямоугольник
    // раздвигается за свои края на ~полпикселя на любом расстоянии; угол - по номеру вершины (4 на прямоугольник:
    // p0, p1, p2, p3 для «+», p0, p3, p2, p1 для «-»). Воду не трогаем - перекрытие прозрачного дало бы линии.
    if (material != 6u) {
        vec3 du = vec3(0), dv = vec3(0);
        du[AX[ai].y] = cu == 1 ? 1.0 : -1.0;
        dv[AX[ai].z] = cv == 1 ? 1.0 : -1.0;
        float eps = 0.0009 * distance(eye.xyz - originOld.xyz, rel);   // полпикселя при обзоре 70° на 720 строк
        // Р92: у предмета с поворотом края раздвигаются в ЕГО осях (иначе стыки вокселей рвутся щелями), а мера
        // - с поправкой на масштаб модели (воксель 1/64 блока)
        if (xf) {
            vec3 q2 = xq + (du + dv) * (eps / max(length(uXf0.xyz), 1e-4));
            rel = xDst + vec3(dot(uXf0.xyz, q2), dot(uXf1.xyz, q2), dot(uXf2.xyz, q2));
        } else rel += (du + dv) * eps;
    }
    gl_Position = viewProj * vec4(rel, 1.0);
    vec3 world = rel + originOld.xyz;   // для шума и расстояний - абсолютно
    // свет: рассеянный по нормали плюс постоянная подсветка неба
    float light = 0.35 + 0.65 * max(dot(uXf == 1 && uFine == 1 ? xfN : NORMALS[normal], normalize(sunDir.xyz)), 0.0);
    if (material == 153u) light = 1.15;   // Р95: контур вырубки и прицел - всегда ярко
    vColor = vec4(COLORS[min(material, 153u)] * light, material == 6u ? WATER_ALPHA : 1.0);
    vMat = min(material, 153u);
    vLight = light;
    vWorld = world;
    vNormal = normal;
    vFoam = 0.0;
    vWater = material == 6u ? 1u : 0u;
}
